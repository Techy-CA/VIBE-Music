VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Auto song-ingestion (api/ingest-songs.ts) ───────────────
# YouTube Data API v3 key — console.cloud.google.com > APIs & Services > Credentials
YOUTUBE_API_KEY=

# Firebase Admin service account JSON, base64-encoded (see README for how to generate)
FIREBASE_SERVICE_ACCOUNT_B64=

# Shared secret — protects /api/ingest-songs from being triggered by randoms.
# Set the same value here and in Vercel's project env vars; Vercel Cron sends
# it automatically as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=
